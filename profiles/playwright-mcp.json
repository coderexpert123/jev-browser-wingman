{
  "id": "playwright-mcp",
  "description": "Playwright MCP server (@playwright/mcp), default and opt-in capabilities",
  "detect": {
    "args_contain": ["@playwright/mcp"],
    "extension_flags": ["--extension"],
    "endpoint_flags": ["--cdp-endpoint"]
  },
  "launch": {
    "endpoint_env": "PLAYWRIGHT_MCP_CDP_ENDPOINT",
    "endpoint_arg": null,
    "strip_args": ["--user-data-dir"]
  },
  "match_tools": ["browser_snapshot", "browser_click"],
  "tools": {
    "browser_click": "element-act",
    "browser_check": "element-act",
    "browser_uncheck": "element-act",
    "browser_type": "type",
    "browser_fill_form": "type",
    "browser_press_sequentially": "type",
    "browser_select_option": "select",
    "browser_press_key": "key",
    "browser_hover": "hover",
    "browser_file_upload": "upload",
    "browser_navigate": "navigate",
    "browser_navigate_back": "back",
    "browser_mouse_click_xy": "pointer-xy",
    "browser_mouse_move_xy": "pointer-xy",
    "browser_mouse_drag_xy": "pointer-xy",
    "browser_mouse_down": "pointer-xy",
    "browser_mouse_up": "pointer-xy",
    "browser_mouse_wheel": "pointer-xy",
    "browser_keydown": "pointer-xy",
    "browser_keyup": "pointer-xy",
    "browser_drag": "drag",
    "browser_drop": "drag",
    "browser_tabs": "tabs",
    "browser_handle_dialog": "dialog",
    "browser_snapshot": "read",
    "browser_take_screenshot": "read",
    "browser_find": "read",
    "browser_console_messages": "read",
    "browser_network_requests": "read",
    "browser_network_request": "read",
    "browser_wait_for": "wait",
    "browser_evaluate": "script",
    "browser_run_code_unsafe": "script",
    "browser_close": "session",
    "browser_resize": "session",
    "browser_reload": "session",
    "browser_navigate_forward": "session"
  },
  "arg_rules": []
}
